# TLS for gateway.peterparker.ca, from Let's Encrypt, renewed by Caddy. The DNS record is
# grey-clouded (DNS only) in Cloudflare so the certificate is this host's own and the load
# test measures no hop but this one. No ACME contact email: none is needed, and this file
# is public. Caddy redacts the Authorization header in its access log, and logs no bodies.
gateway.peterparker.ca {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	# A chat request is a page or two of text; nothing the proxy accepts is near this.
	request_body {
		max_size 2MB
	}
	# The project's website (0.31, docs/site.md): built from the checkout by the one-shot
	# `site` service into /srv/boundary/site, and served here with a content security policy
	# that allows nothing inline and nothing from another host. These paths are the site's
	# files (boundary.site.ASSETS); every other path is the proxy's, /demo and /dashboard
	# included, which set no such policy.
	@site path / /index.html /style.css /app.js /fonts/* /data/*
	handle @site {
		root * /srv/site/current
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://raw.githubusercontent.com; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
			Cache-Control "public, max-age=300"
		}
		file_server
	}
	# Streaming answers are server-sent events; flush each one as it arrives.
	handle {
		reverse_proxy gateway:8080 {
			flush_interval -1
		}
	}
	log {
		output stdout
		format json
	}
}
